# ReactMod Bot Configuration


# 1. Discord Bot Token (REQUIRED)
# Get from Discord Developer Portal -> Your App -> Bot -> Reset Token
DISCORD_TOKEN=your_bot_token_here

# 2. Discord OAuth2 Credentials (REQUIRED for web panel Discord Login)
# Get from Discord Developer Portal -> Your App -> OAuth2 -> General
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here

# 3. OAuth2 Redirect URI
# Must match the redirect URL registered in Discord Developer Portal -> OAuth2 -> Redirects
REDIRECT_URI=http://localhost:3000/auth/callback

# 4. Web Panel Port (Default: 3000)
PORT=3000

# 5. Optional Admin Fallback Password
# Allows signing in directly to the panel without Discord OAuth during local testing
PANEL_PASSWORD=admin123
